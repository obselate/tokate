<Project Sdk="Gsharp.NET.Sdk/0.4.1150">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TokateDesktop</RootNamespace>
    <AssemblyName>tokate-desktop</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>0.2.104</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.gs" />
    <PackageReference Include="Goo" Version="0.7.27" />
    <PackageReference Include="Goo.Svg" Version="0.7.27" />
    <PackageReference Include="Goo.Widgets" Version="0.2.15" />
    <PackageReference Include="Goo.Animations" Version="0.2.5" />
    <GooShaderEffect Include="Shaders/fresco.slang" />
    <Content Include="Assets/*" CopyToOutputDirectory="PreserveNewest" />
    <Watch Include="**/*.gs" Exclude="bin/**;obj/**" />
  </ItemGroup>
</Project>
