<Project Sdk="Gsharp.NET.Sdk/0.4.1150">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.gs;../../Models/**/*.gs;../../Services/**/*.gs;../../Components/Theme.gs" />
    <PackageReference Include="Goo" Version="0.7.18" />
    <PackageReference Include="Goo.Svg" Version="0.7.18" />
    <PackageReference Include="Goo.Animations" Version="0.2.5" />
    <Content Include="Fixtures/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
